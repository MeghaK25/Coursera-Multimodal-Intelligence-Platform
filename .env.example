# .env.example — copy this to .env and fill in your values
# NEVER commit .env to version control

# PostgreSQL connection
DB_HOST=localhost
DB_PORT=5432
DB_NAME=coursera_platform
DB_USER=coursera_user
DB_PASSWORD=your_secure_password_here

# Dataset paths (absolute or relative to project root)
SOURCE_ZIP=data/../IBM Data Science Professional Certificate.zip
RAW_DATA_DIR=data/raw
PROCESSED_DATA_DIR=data/processed
INVENTORY_DIR=data/inventory

# Pipeline configuration
VIDEO_SEGMENT_SECONDS=300         # window size for video time-segmentation
TXT_CHUNK_TARGET_TOKENS=500       # target token count per TXT transcript chunk
TXT_CHUNK_OVERLAP_TOKENS=50       # overlap between consecutive TXT chunks
SRT_ALIGN_CONFIDENCE_THRESHOLD=0.8 # minimum ratio for SRT→TXT timestamp alignment

# Logging
LOG_LEVEL=INFO                    # DEBUG | INFO | WARNING | ERROR
LOG_FILE=logs/pipeline.log        # set to empty string to disable file logging

# Processing flags
SKIP_VIDEO_METADATA=false         # set true to skip ffprobe (useful if ffmpeg not installed)
EXTRACT_FRAMES=false              # set true to enable frame extraction (disabled by default)
